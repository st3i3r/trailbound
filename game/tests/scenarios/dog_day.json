{
  "id": "dog_day",
  "title": "The stray: pet once a day, bond grows, second pet refused",
  "site": "pinewatch",
  "seed": 19,
  "setup": {
    "coins": 100,
    "day": 2,
    "phase": 3,
    "sites_visited": { "pinewatch": 0 },
    "dog": { "name": "Bean", "bond": 0, "met": true,
      "adopted": false, "pet_today": false }
