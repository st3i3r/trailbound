{
  "id": "crew_clock",
  "title": "Crew clock: hut starts -> clock catches up -> stage collects",
  "site": "pinewatch",
  "seed": 13,
  "setup": {
    "coins": 300,
    "day": 4,
    "phase": 3,
    "sites_visited": { "pinewatch": 0 }
  },
  "steps": [
    { "op": "crew_start", "structure": "wardens_hut" },
    { "op": "expect", "crew.structure": "wardens_hut",
        "crew.stage": 0 },
    { "op": "crew_set", "key": "last_seen_utc", "value": 1000000 },
    { "op": "crew_tick", "now": 2000000000 },
    { "op": "expect", "crew.seconds_left": 0.0 },
    { "op": "crew_collect" },
    { "op": "expect", "crew.stage": 1,
        "crew.collected.count": 1 }
  ],
  "expect": {
    "crew.stage": 1,
    "crew.collected.count": 1
  }
}
