{
  "id": "day1_seat_serve",
  "title": "Day-1 loop: staples -> seat -> cook -> serve favourite -> settle",
  "site": "pinewatch",
  "seed": 7,
  "setup": {
    "coins": 300,
    "day": 1,
    "phase": 3,
    "pantry": { "mushroom": 1, "herb": 1 },
    "sites_visited": { "pinewatch": 0 }
  },
  "steps": [
    { "op": "site_set", "key": "pages_done", "value": [1] },
    { "op": "buy_staple", "id": "tea" },
    { "op": "expect", "coins": 295, "pantry.has": ["tea", "mushroom", "herb"] },
    { "op": "inject_guest", "id": "hiker", "arch": "hiker", "fee": 40,
        "pads": 1, "favourite": "trail_stew" },
    { "op": "seat", "guest": "hiker", "pads": ["p1"] },
    { "op": "expect", "site.assignments.count": 1,
        "site.assignments.has": "hiker" },
    { "op": "cook", "a": "mushroom", "b": "herb" },
    { "op": "expect", "meals.count": 1, "pantry.has!=": "mushroom" },
    { "op": "set_phase", "phase": "evening" },
    { "op": "serve", "guest": "hiker", "meal": "trail_stew" },
    { "op": "expect", "site.served.hiker": "trail_stew" },
    { "op": "save_load" },
    { "op": "expect", "site.served.hiker": "trail_stew",
        "site.assignments.count": 1 },
    { "op": "goodnight" }
  ],
  "expect": {
    "phase": "night",
    "site.assignments.count": 0,
    "site.guests.count": 0,
    "coins>=": 300
  },
  "twice": true
}
