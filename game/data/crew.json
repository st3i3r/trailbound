{
  "clock": {
    "source": "device_utc",
    "progress_rule": "max(0, now_utc - last_seen_utc)",
    "back_never_undoes": true,
    "forward_finishes_early": true,
    "never_feeds_rng": true
  },
  "speed_up": {
    "ad_placement": "crew_speed_up",
    "chunk_rule": "max(900, stage_seconds / 6)",
    "max_per_stage": 3,
    "max_per_calendar_day": 6,
    "free_finish_seconds": 300,
    "available_from_day": 4
  },
  "notification": {
    "asked_once_when": "wardens_hut:roof_starts",
    "max_per_calendar_day": 1,
    "quiet_hours": {"start": 21, "end": 9},
    "merge_with_daily_within_minutes": 120,
    "inexact_timing": true
  },
  "structures": [
    {
      "id": "wardens_hut",
      "site": "pinewatch",
      "label": "Warden's Hut",
      "auto_start": "day_2",
      "art_states": ["ruin", "brambles_cleared", "roof_fixed", "restored"],
      "vignette": "porch_light",
      "stages": [
        {"id": "brambles", "label": "Brambles cleared", "seconds": 600,
         "keepsake": {"id": "grandpas_thermos", "label": "Grandpa's thermos",
                      "art": "keepsake_thermos", "note_key": "keepsake.thermos"}},
        {"id": "roof", "label": "Roof fixed", "seconds": 14400,
         "keepsake": {"id": "old_trail_register", "label": "The old trail register",
                      "art": "keepsake_register", "note_key": "keepsake.register"}},
        {"id": "porch", "label": "Porch rebuilt", "seconds": 28800,
         "keepsake": {"id": "photo_on_the_porch", "label": "A photo of him on the porch",
                      "art": "keepsake_photo", "note_key": "keepsake.photo"}}
      ]
    },
    {
      "id": "boathouse",
      "site": "whisper_river",
      "label": "Boathouse",
      "auto_start": "site_reached_and_crew_free",
      "art_states": ["ruin", "stage_1", "stage_2", "restored"],
      "vignette": "boat_on_the_river",
      "stages": [
        {"id": "stage_1", "label": "Stage 1", "seconds": 3600,
         "keepsake": {"id": "carved_oar", "label": "An oar carved with two sets of initials",
                      "art": "keepsake_oar", "note_key": "keepsake.oar"}},
        {"id": "stage_2", "label": "Stage 2", "seconds": 14400,
         "keepsake": {"id": "river_chart", "label": "His river chart",
                      "art": "keepsake_chart", "note_key": "keepsake.chart"}},
        {"id": "stage_3", "label": "Stage 3", "seconds": 28800,
         "keepsake": {"id": "old_bas_boat", "label": "The boat he shared with Old Ba, afloat again",
                      "art": "keepsake_boat", "note_key": "keepsake.boat"}}
      ]
    },
    {
      "id": "lantern_workshop",
      "site": "lantern_valley",
      "label": "Lantern Workshop",
      "auto_start": "site_reached_and_crew_free",
      "art_states": ["ruin", "stage_1", "stage_2", "restored"],
      "vignette": "lanterns_over_the_valley",
      "stages": [
        {"id": "stage_1", "label": "Stage 1", "seconds": 7200,
         "keepsake": {"id": "bamboo_frames", "label": "Bamboo frames and rice paper",
                      "art": "keepsake_frames", "note_key": "keepsake.frames"}},
        {"id": "stage_2", "label": "Stage 2", "seconds": 21600,
         "keepsake": {"id": "pattern_book", "label": "His pattern book",
                      "art": "keepsake_book", "note_key": "keepsake.book"}},
        {"id": "stage_3", "label": "Stage 3", "seconds": 43200,
         "keepsake": {"id": "unfinished_lantern", "label": "His last unfinished lantern, which you finish",
                      "art": "keepsake_lantern", "note_key": "keepsake.lantern"}}
      ]
    }
  ],
  "volume2_note": "Layouts reserve 2 overgrown plots per site for v1.1 restorations (§6.11): fire_tower + pond_dock (P), bamboo_treehouse + bathhouse (W), observatory + long_table (L); stage costs 1h·4h·8h crew time, one team per site. Draft — not v1 data."
}
